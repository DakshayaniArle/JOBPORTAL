# ===================================================================
# JobPortal Backend - Environment Variables Template
# Copy this file to .env or configure these variables in your deployment
# NEVER commit actual passwords, tokens or credentials to version control.
# ===================================================================

# Database Settings
DB_URL=jdbc:mysql://localhost:3306/jobportal
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# Mail Service Settings (Gmail SMTP App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# JWT Authentication (HS256 requires a 256-bit / 32+ character key)
JWT_SECRET=your_32_character_jwt_secret_key_here

